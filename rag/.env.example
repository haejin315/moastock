# cp .env.example .env  (.env는 커밋되지 않는다)
DART_API_KEY=
# 데이터 위치 (원천 SQLite, parquet, 임베딩, 지표). 저장소 밖, 여유 있는 드라이브로.
MOARAG_DATA_DIR=D:/moastock-rag/data
# 수집 기간(일)
MOARAG_WINDOW_DAYS=183
# 저장소 접속 - 클라우드 이전 시 여기만 바꾸면 된다
MOARAG_PG_DSN=postgresql://moarag:moarag@127.0.0.1:5432/moarag
MOARAG_QDRANT_URL=http://127.0.0.1:6333
MOARAG_OPENSEARCH_URL=http://127.0.0.1:9200
